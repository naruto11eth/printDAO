# ============================================
# PrintDAO Configuration
# ============================================
# Copy this file to .env and fill in your values

# --------------------------------------------
# Telegram Bot Configuration
# --------------------------------------------
# Get your bot token from @BotFather on Telegram
# 1. Open Telegram, search for @BotFather
# 2. Send /newbot and follow the prompts
# 3. Copy the token here
TELEGRAM_BOT_TOKEN="8455730630:AAHtTyDUcXc3KuKF74ShqfLslDkB3ZNrXmA"

# NOTE: Chat ID is NOT required!
# The bot works dynamically in any group it's added to.
# Just add the bot to your group and start using commands.

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
# Local Docker: redis://localhost:6379/0
# Redis Cloud: redis://user:password@host:port/0
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# Alert Thresholds
# --------------------------------------------
# Minimum trade size to trigger whale alerts (in USD)
HYPERLIQUID_WHALE_THRESHOLD=10000000
POLYMARKET_WHALE_THRESHOLD=10000

# --------------------------------------------
# Rate Limits
# --------------------------------------------
# Max wallets a user can track
MAX_TRACKED_WALLETS_PER_USER=20

# --------------------------------------------
# Logging
# --------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
